{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podflow.local/schemas/episode_run.schema.json",
  "title": "PodFlow Studio EpisodeRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "preset",
    "source_inputs",
    "facts",
    "selected_topics",
    "script",
    "edited_script",
    "voice_segments",
    "audio_outputs",
    "release_readiness",
    "publish_outputs",
    "run_report"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "episode_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "preset": {
      "type": "object",
      "required": ["id", "content_type", "num_hosts"],
      "additionalProperties": true,
      "properties": {
        "id": { "const": "morning_news_brief" },
        "content_type": { "const": "news_brief" },
        "num_hosts": { "const": 1 }
      }
    },
    "source_inputs": { "type": "array", "items": { "type": "object" } },
    "runtime_config": { "type": "object" },
    "logs": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "object" } },
    "fetch_contents": { "type": "array", "items": { "type": "object" } },
    "cleaned_contents": { "type": "array", "items": { "type": "object" } },
    "researched_contents": { "type": "array", "items": { "type": "object" } },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/factCard" }
    },
    "selected_topics": { "type": "array", "items": { "type": "object" } },
    "selected_topic": { "type": "object" },
    "selected_materials": { "type": "array", "items": { "type": "object" } },
    "auto_selected_items": { "type": "array", "items": { "type": "object" } },
    "auto_rejected_items": { "type": "array", "items": { "type": "object" } },
    "script": { "$ref": "#/$defs/script" },
    "edited_script": { "$ref": "#/$defs/script" },
    "generation_request": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "maxProperties": 0 },
        { "required": ["mode"] }
      ],
      "properties": {
        "mode": { "enum": ["initial", "regenerate"] },
        "require_llm": { "type": "boolean" },
        "requested_at": { "type": "string" },
        "status": {
          "oneOf": [
            { "const": "failed" },
            { "type": "null" }
          ]
        },
        "failed_at": { "type": "string" },
        "draft_snapshot": {
          "oneOf": [
            { "$ref": "#/$defs/script" },
            { "type": "null" }
          ]
        }
      }
    },
    "generation_meta": { "type": "object", "additionalProperties": true },
    "script_snapshots": { "type": "array", "items": { "type": "object" } },
    "downstream_stale": { "type": "object", "additionalProperties": true },
    "voice_segments": { "type": "array", "items": { "$ref": "#/$defs/voiceSegment" } },
    "production_plan": { "$ref": "#/$defs/productionPlan" },
    "audio_outputs": { "$ref": "#/$defs/audioOutputs" },
    "cover_path": { "type": "string" },
    "intro_outro_paths": { "type": "object", "additionalProperties": { "type": "string" } },
    "review_summary": { "type": "object" },
    "audio_approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["approved", "rejected"] },
        "audio_sha256": { "type": "string", "pattern": "^(?:|[a-f0-9]{64})$" },
        "reviewed_at": { "type": "string" },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" }
        ,"acknowledgements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["full_listen_confirmed", "pronunciation_confirmed", "editorial_final_confirmed"] }
        }
      }
    },
    "release_readiness": { "$ref": "#/$defs/releaseReadiness" },
    "publish_outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "episode_dir": { "type": "string" },
        "audio_path": { "type": "string" },
        "episode_json": { "type": "string" },
        "show_notes": { "type": "string" },
        "transcript_vtt": { "type": "string" },
        "chapters_json": { "type": "string" },
        "sources_json": { "type": "string" },
        "feed_xml": { "type": "string" },
        "run_report_json": { "type": "string" },
        "enclosure_url": { "type": "string" },
        "local_preview_only": { "type": "boolean" },
        "contains_mock_audio": { "type": "boolean" },
        "package_feed_xml": { "type": "string" },
        "published_at": { "type": "string" },
        "status": { "enum": ["success", "partial_success", "failed", "demo_only"] },
        "enabled_platforms": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "object", "additionalProperties": { "type": "string" } },
        "rss_validation_ok": { "type": "boolean" },
        "warning": { "type": "string" },
        "public": { "type": "boolean" },
        "release_status": { "enum": ["demo_only", "preview_unreviewed", "published"] },
        "reason": { "type": "string" },
        "rss_validation": { "$ref": "#/$defs/rssValidation" }
      }
    },
    "subtitle_path": { "type": "string" },
    "run_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "episode_id": { "type": "string" },
        "preset_id": { "type": "string" },
        "facts": { "type": "object" },
        "script": { "type": "object" },
        "audio": { "type": "object" },
        "publish": { "type": "object" },
        "schema_validation": { "type": "object" },
        "rss_validation": { "$ref": "#/$defs/rssValidation" },
        "tts_live_validation": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "object" } },
        "release_readiness": { "$ref": "#/$defs/releaseReadiness" },
        "quality_rules": { "type": "object" },
        "verification_models": { "type": "array", "items": { "type": "string" } },
        "editorial_quality": { "type": "object" },
        "repair_count": { "type": "integer", "minimum": 0 },
        "degradation_reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "discover_meta": { "type": "object" },
    "discover_ui": { "type": "object" },
    "organize_ui": { "type": "object" },
    "episode_brief": { "type": "object" },
    "writing_meta": { "type": "object" },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "maxProperties": 0 }, { "required": ["id", "title", "cadence", "defaults"] }],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "coverPath": { "type": "string" },
        "cadence": { "enum": ["daily", "weekly"] },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "targetDurationMinutes", "author", "hostName", "defaultVoice", "enabledPlatforms", "templateVariant"],
          "properties": {
            "language": { "type": "string" },
            "targetDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
            "author": { "type": "string" },
            "hostName": { "type": "string" },
            "defaultVoice": { "type": "string" },
            "enabledPlatforms": { "type": "array", "items": { "type": "string" } },
            "templateVariant": { "const": "quick_6_plus_deep_1" }
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positionSeconds": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "completed": { "type": "boolean" },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "playCount": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "string" }
      }
    },
    "_manifest": { "type": "object" }
  },
  "$defs": {
    "releaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "codes", "messages", "evidence"],
      "properties": {
        "status": { "enum": ["passed", "failed", "pending"] },
        "codes": { "type": "array", "items": { "type": "string" } },
        "messages": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "releaseReadiness": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "maxProperties": 0 }, { "required": ["version", "status", "audio_sha256", "evaluated_at", "gates"] }],
      "properties": {
        "version": { "const": 1 },
        "status": { "enum": ["blocked", "preview_ready", "publish_ready"] },
        "audio_sha256": { "type": "string", "pattern": "^(?:|[a-f0-9]{64})$" },
        "evaluated_at": { "type": "string" },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "facts", "script", "pronunciation", "audio", "human_approval"],
          "properties": {
            "sources": { "$ref": "#/$defs/releaseGate" },
            "facts": { "$ref": "#/$defs/releaseGate" },
            "script": { "$ref": "#/$defs/releaseGate" },
            "pronunciation": { "$ref": "#/$defs/releaseGate" },
            "audio": { "$ref": "#/$defs/releaseGate" },
            "human_approval": { "$ref": "#/$defs/releaseGate" }
          }
        }
      }
    },
    "factCard": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["is_deep_dive"],
            "properties": { "is_deep_dive": { "const": true } }
          },
          "then": { "required": ["deep_dive_brief"] }
        }
      ],
      "required": [
        "id",
        "title",
        "summary",
        "confidence",
        "evidence",
        "claims",
        "used_in_segments"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^fact_[0-9]{3}$" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verifiedClaim" } },
        "is_deep_dive": { "type": "boolean" },
        "deep_dive_brief": { "$ref": "#/$defs/deepDiveBrief" },
        "used_in_segments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title", "published_at", "source_role", "excerpt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string" },
        "source_role": { "enum": ["primary", "independent", "background"] },
        "excerpt": { "type": "string", "minLength": 1 }
      }
    },
    "verifiedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence_ids", "status", "confidence", "verifier_model", "verified_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": { "enum": ["supported", "conflicted", "insufficient"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "verifier_model": { "type": "string" },
        "verified_at": { "type": "string" }
      }
    },
    "deepDiveClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceUrls", "confidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "deepDiveSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "question", "listenerValue", "claims"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "listenerValue": { "type": "string", "minLength": 1 },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deepDiveClaim" }
        }
      }
    },
    "deepDiveBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "inputFingerprint",
        "coreQuestion",
        "whyNow",
        "thesisBoundary",
        "sections",
        "counterpoints",
        "limitations",
        "sourceUrls",
        "generatedAt"
      ],
      "properties": {
        "version": { "const": 1 },
        "inputFingerprint": { "type": "string", "pattern": "^[a-f0-9]{8}$" },
        "coreQuestion": { "type": "string", "minLength": 1 },
        "whyNow": { "type": "string", "minLength": 1 },
        "thesisBoundary": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/deepDiveSection" }
        },
        "counterpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deepDiveClaim" }
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content_type": { "const": "news_brief" },
        "preset_id": { "const": "morning_news_brief" },
        "num_hosts": { "const": 1 },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/scriptSegment" }
        },
        "generated_by": { "type": "string" },
        "edited_from": { "type": "string" },
        "edit_mode": { "type": "string" },
        "manual_notes": { "type": "string" },
        "facts_snapshot": { "type": "array", "items": { "$ref": "#/$defs/factCard" } },
        "recommended_news_item_count": { "type": "integer" },
        "recommended_quick_news_count": { "type": "integer" },
        "recommended_deep_dive_count": { "type": "integer" },
        "actual_news_item_count": { "type": "integer" },
        "actual_quick_news_count": { "type": "integer" },
        "actual_deep_dive_count": { "type": "integer" },
        "template_variant": { "type": "string" },
        "generation_profile": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "scriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "source_fact_ids", "source_claim_ids", "estimated_seconds"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["opening", "quick_news", "deep_dive", "closing", "custom"]
        },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "source_fact_ids": { "type": "array", "items": { "type": "string" } },
        "source_claim_ids": { "type": "array", "items": { "type": "string" } },
        "estimated_seconds": { "type": "integer", "minimum": 0 },
        "speaker": { "type": "string" }
      }
    },
    "voiceSegment": {
      "type": "object",
      "required": ["segment_id", "source_fact_ids", "source_claim_ids"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "source_fact_ids": { "type": "array", "items": { "type": "string" } },
        "source_claim_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "rssValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "errors", "warnings", "enclosure_url", "local_preview_only"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "enclosure_url": { "type": "string" },
        "local_preview_only": { "type": "boolean" }
      }
    },
    "audioOutputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "final_audio_path": { "type": "string" },
        "format": { "type": "string" },
        "requested_format": { "type": "string" },
        "degraded": { "type": "boolean" },
        "duration_seconds": { "type": "number" },
        "segments_count": { "type": "integer" },
        "source_segments": { "type": "array", "items": { "type": "string" } },
        "source_engines": { "type": "array", "items": { "type": "string" } },
        "contains_mock_audio": { "type": "boolean" },
        "missing_segments": { "type": "array", "items": { "type": "string" } },
        "operations": { "type": "array", "items": { "type": "string" } },
        "file_size": { "type": "integer" },
        "audio_report_path": { "type": "string" },
        "audio_artifact": { "type": "object" },
        "sample_rate_hz": { "type": "integer" },
        "bitrate_kbps": { "type": "integer" },
        "target_lufs": { "type": ["number", "null"] },
        "true_peak_db": { "type": ["number", "null"] },
        "message": { "type": "string" }
      }
    },
    "productionMusicSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path", "gain_db", "duration_ms", "fade_in_ms", "fade_out_ms", "voice_overlap_ms", "duck_db", "rights_ref"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "fade_in_ms": { "type": "integer", "minimum": 0, "maximum": 15000 },
        "fade_out_ms": { "type": "integer", "minimum": 0, "maximum": 15000 },
        "voice_overlap_ms": { "type": "integer", "minimum": 0, "maximum": 15000 },
        "duck_db": { "type": "number", "minimum": 0, "maximum": 30 },
        "rights_ref": { "type": "string", "minLength": 1 }
      }
    },
    "productionPlan": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "maxProperties": 0 },
        {
          "required": [
            "version", "quality_profile", "script_hash", "clips", "joins", "music", "render", "updated_at"
          ]
        }
      ],
      "properties": {
        "version": { "const": 4 },
        "quality_profile": { "const": "podflow_morning_v4" },
        "script_hash": { "type": "string" },
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "parent_segment_id", "segment_type", "segment_title", "text",
              "context_before", "context_after", "direction", "speaker",
              "source_fact_ids", "source_claim_ids", "source", "path", "duration_seconds", "trim_start_ms",
              "trim_end_ms", "generation_key"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "parent_segment_id": { "type": "string", "minLength": 1 },
              "segment_type": { "enum": ["opening", "quick_news", "deep_dive", "closing", "custom"] },
              "segment_title": { "type": "string" },
              "text": { "type": "string", "minLength": 1 },
              "context_before": { "type": "string" },
              "context_after": { "type": "string" },
              "direction": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "intent", "provider_emotion", "emotion_scale", "energy", "pace",
                  "pause_before_ms", "pause_after_ms", "emphasis"
                ],
                "properties": {
                  "intent": { "type": "string", "minLength": 1 },
                  "provider_emotion": { "enum": ["happy", "neutral", "surprised", "excited", "coldness"] },
                  "emotion_scale": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "energy": { "type": "number", "minimum": 0, "maximum": 1 },
                  "pace": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
                  "pause_before_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
                  "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
                  "emphasis": {
                    "type": "array",
                    "maxItems": 2,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "speaker": { "type": "string" },
              "source_fact_ids": { "type": "array", "items": { "type": "string" } },
              "source_claim_ids": { "type": "array", "items": { "type": "string" } },
              "source": { "enum": ["tts", "recording", "local"] },
              "path": { "type": "string" },
              "duration_seconds": { "type": "number", "minimum": 0 },
              "trim_start_ms": { "type": "integer", "minimum": 0 },
              "trim_end_ms": { "type": "integer", "minimum": 0 },
              "generation_key": { "type": "string" }
            }
          }
        },
        "joins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after_clip_id", "type", "duration_ms"],
            "properties": {
              "after_clip_id": { "type": "string" },
              "type": { "enum": ["pause", "sting", "bridge"] },
              "duration_ms": { "type": "integer", "minimum": 0, "maximum": 15000 }
            }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intro", "sting", "bridge", "outro"],
          "properties": {
            "intro": { "$ref": "#/$defs/productionMusicSlot" },
            "sting": { "$ref": "#/$defs/productionMusicSlot" },
            "bridge": { "$ref": "#/$defs/productionMusicSlot" },
            "outro": { "$ref": "#/$defs/productionMusicSlot" }
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_format", "sample_rate_hz", "mp3_bitrate", "normalize_loudness", "target_lufs", "true_peak_db"],
          "properties": {
            "output_format": { "enum": ["mp3", "wav", "opus"] },
            "sample_rate_hz": { "const": 48000 },
            "mp3_bitrate": { "const": "160k" },
            "normalize_loudness": { "type": "boolean" },
