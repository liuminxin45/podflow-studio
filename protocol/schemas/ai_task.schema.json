{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podflow.local/schemas/ai_task.schema.json",
  "title": "PodFlow AI Task Contract",
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "requests"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "task_id", "target_id", "input", "stream"],
      "properties": {
        "version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "input": {"type": "object"},
        "stream": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "task_id", "output", "usage"],
      "properties": {
        "version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "output": {"type": "object"},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_id", "task_id", "sequence", "type", "payload"],
      "properties": {
        "version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "type": {
          "enum": ["started", "progress", "text_delta", "tool_started", "tool_finished", "completed", "failed", "cancelled"]
        },
        "payload": {"type": "object"}
      }
    }
  }
}
